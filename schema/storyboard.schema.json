{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file; only the script stage writes to it (to fill missing translations).",
  "type": "object",
  "required": [
    "title",
    "logline",
    "language",
    "voice",
    "style_block",
    "character",
    "music",
    "shots"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "description": "BCP-47 code of the narration language, e.g. am, om, ti, en"
    },
    "language_name": {
      "type": "string"
    },
    "voice": {
      "type": "object",
      "required": [
        "model",
        "name",
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Gemini prebuilt voice name"
        },
        "style": {
          "type": "string",
          "description": "SHORT delivery prefix ending with a colon, e.g. 'Say warmly:'. Long instructions get read aloud."
        },
        "fallback_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tried in order when a model's daily quota is used up"
        },
        "speed": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.3,
          "description": "Tempo applied in FFmpeg after TTS (pitch preserved)"
        }
      }
    },
    "image_model": {
      "type": "string"
    },
    "style_block": {
      "type": "string",
      "minLength": 10,
      "description": "Appended to every image prompt to lock the look"
    },
    "character": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "real_person": {
          "type": "boolean",
          "description": "true if this depicts a real person - consent must be in ETHICS.md"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narration_lead_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "narration_padding_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "end_card_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 6
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "source",
        "caption"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "placeholder",
            "file"
          ],
          "description": "placeholder = synthesised pad; file = outputs/music/score.wav from ACE-Step"
        },
        "file": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "key": {
          "type": "string"
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at_shot",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "at_shot": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "duration",
          "shot_size",
          "image_prompt",
          "motion_prompt",
          "camera",
          "narration_en"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "description": "Why this shot exists"
          },
          "duration": {
            "type": "number",
            "minimum": 3,
            "maximum": 15
          },
          "shot_size": {
            "enum": [
              "extreme-wide",
              "wide",
              "medium",
              "medium-close-up",
              "close-up",
              "extreme-close-up",
              "insert"
            ]
          },
          "with_character": {
            "type": "boolean"
          },
          "image_prompt": {
            "type": "string",
            "minLength": 10
          },
          "motion_prompt": {
            "type": "string",
            "description": "For Wan 2.2: motion and camera only"
          },
          "camera": {
            "type": "object",
            "required": [
              "zoom"
            ],
            "additionalProperties": false,
            "description": "Ken Burns fallback movement",
            "properties": {
              "zoom": {
                "enum": [
                  "in",
                  "out",
                  "none"
                ]
              },
              "pan": {
                "enum": [
                  "left",
                  "right",
                  "up",
                  "down",
                  "none"
                ]
              }
            }
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "narration": {
            "type": "string",
            "description": "Spoken line in the narration language (filled by the script stage if empty)"
          },
          "narration_en": {
            "type": "string",
            "minLength": 1,
            "description": "English line, used for subtitles"
          },
          "narration_reviewed": {
            "type": "boolean",
            "description": "true once a native speaker has checked the line"
          }
        }
      }
    }
  }
}
